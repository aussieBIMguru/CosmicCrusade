<UserControl x:Class="CosmicCrusade.App.Views.GameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CosmicCrusade.App.Controls"
             Focusable="True">
    <Grid x:Name="Root" Background="#03040E">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <!-- ===================== PLAY AREA ===================== -->
        <Grid x:Name="PlayArea" Grid.Column="0" ClipToBounds="True"
              MouseWheel="PlayArea_MouseWheel" MouseRightButtonDown="PlayArea_MouseRightButtonDown">

            <controls:Starfield />

            <!-- Behind the board, in front of the stars: planets and moons that rise in the sky (Warzone ambients). -->
            <Canvas x:Name="SkyCanvas" IsHitTestVisible="False" ClipToBounds="True" />

            <!-- The board: a 2D canvas mapped onto a tilted 3D plane. It stays fully interactive. -->
            <Viewport3D x:Name="Viewport" ClipToBounds="False">
                <Viewport3D.Camera>
                    <PerspectiveCamera x:Name="Camera" FieldOfView="50" NearPlaneDistance="0.1" FarPlaneDistance="200" />
                </Viewport3D.Camera>
                <ModelVisual3D>
                    <ModelVisual3D.Content>
                        <AmbientLight Color="White" />
                    </ModelVisual3D.Content>
                </ModelVisual3D>
                <Viewport2DVisual3D x:Name="BoardVisual3D">
                    <Viewport2DVisual3D.Geometry>
                        <MeshGeometry3D Positions="-8,-5,0 8,-5,0 8,5,0 -8,5,0"
                                        TextureCoordinates="0,1 1,1 1,0 0,0"
                                        TriangleIndices="0 1 2 0 2 3" />
                    </Viewport2DVisual3D.Geometry>
                    <Viewport2DVisual3D.Material>
                        <DiffuseMaterial Viewport2DVisual3D.IsVisualHostMaterial="True" Brush="White" />
                    </Viewport2DVisual3D.Material>
                    <!-- The plane fits the *contents* of this visual, measured inside the root (the root's own clip
                         doesn't count). So the root is a fixed 1600×1000 frame: a transparent rectangle pins its size,
                         and BoardCanvas inside it is clipped, so nothing drawn on the board (glows, sparks, ambients past
                         the edges) can ever change the size the plane sees. Board coordinates are unchanged. -->
                    <Viewport2DVisual3D.Visual>
                        <Canvas x:Name="BoardRoot" Width="1600" Height="1000">
                            <Rectangle Width="1600" Height="1000" Fill="Transparent" IsHitTestVisible="False" />
                            <Canvas x:Name="BoardCanvas" Width="1600" Height="1000" ClipToBounds="True" />
                        </Canvas>
                    </Viewport2DVisual3D.Visual>
                </Viewport2DVisual3D>
            </Viewport3D>

            <!-- Hands (2D overlay, partly off-screen like a real hand) -->
            <Canvas x:Name="OpponentHandCanvas" VerticalAlignment="Top" Height="70" />
            <Canvas x:Name="HandCanvas" VerticalAlignment="Bottom" Height="150" />

            <!-- The priority stack (top first). Shown only while something is on it. -->
            <Border x:Name="StackHost" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0"
                    Visibility="Collapsed" Padding="8" CornerRadius="12" Background="#D007091C"
                    BorderBrush="#88C084FC" BorderThickness="1.5" MaxWidth="250">
                <Border.Effect>
                    <DropShadowEffect Color="#C084FC" BlurRadius="24" ShadowDepth="0" Opacity="0.6" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="STACK" FontFamily="{StaticResource DisplayFont}" FontSize="22" Foreground="#FFD8B4FE"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="top resolves first" Style="{StaticResource Muted}" FontSize="11"
                               HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <StackPanel x:Name="StackList" />
                </StackPanel>
            </Border>

            <!-- Flying cards, shockwaves, banners -->
            <Canvas x:Name="FxCanvas" IsHitTestVisible="False" />

            <!-- Hover magnifier for hand cards (never takes the mouse, so the hand underneath keeps working) -->
            <Canvas x:Name="MagnifyCanvas" IsHitTestVisible="False" />

            <Border x:Name="Banner" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"
                    IsHitTestVisible="False" Padding="48,18" CornerRadius="18" Background="#CC07091C"
                    BorderBrush="#AA4FD1FF" BorderThickness="2" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="BannerScale" ScaleX="1" ScaleY="1" />
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect x:Name="BannerGlow" Color="#4FD1FF" BlurRadius="40" ShadowDepth="0" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="BannerTitle" FontFamily="{StaticResource DisplayFont}" FontSize="76"
                               HorizontalAlignment="Center" Foreground="White" />
                    <TextBlock x:Name="BannerSubtitle" FontSize="20" HorizontalAlignment="Center"
                               Foreground="#FFB9C6F0" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- Ability choices (targets, nodes, yes/no...). Board cards and nodes can be clicked too. -->
            <Border x:Name="ChoicePanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,64,0,0" MaxWidth="760" Padding="16,12" CornerRadius="16" Background="#EE0A0D24"
                    BorderBrush="#CCFFC94A" BorderThickness="2">
                <Border.Effect>
                    <DropShadowEffect Color="#FFC94A" BlurRadius="30" ShadowDepth="0" Opacity="0.7" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="ChoiceTitle" FontFamily="{StaticResource DisplayFont}" FontSize="26"
                               Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                    <TextBlock x:Name="ChoiceCardText" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap"
                               TextAlignment="Center" HorizontalAlignment="Center" Margin="0,2,0,8" />
                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <WrapPanel x:Name="ChoiceOptions" HorizontalAlignment="Center" />
                    </ScrollViewer>
                    <Grid Margin="0,8,0,0">
                        <TextBlock x:Name="ChoiceCount" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                        <Button x:Name="ChoiceConfirm" Content="CONFIRM" Style="{StaticResource SmallButton}"
                                HorizontalAlignment="Right" Click="ChoiceConfirm_Click" ToolTip="Confirm (Enter)" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Pile viewer: every card in a face-up pile, newest first (GameView.PileViewer.cs). Below the inspect
                 overlay, so right-clicking a card in it still enlarges it. -->
            <Grid x:Name="PileViewerOverlay" Visibility="Collapsed" Background="#C8020310" MouseDown="PileViewerOverlay_MouseDown">
                <Border x:Name="PileViewerPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="18,14"
                        CornerRadius="16" Background="#F00A0D24" BorderBrush="#AA4FD1FF" BorderThickness="2"
                        RenderTransformOrigin="0.5,0.5" MouseDown="PileViewerPanel_MouseDown">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="PileViewerScale" ScaleX="1" ScaleY="1" />
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect Color="#4FD1FF" BlurRadius="30" ShadowDepth="0" Opacity="0.5" />
                    </Border.Effect>
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="CLOSE" Style="{StaticResource SmallButton}" Margin="8,0,0,0"
                                    VerticalAlignment="Center" Click="PileViewerClose_Click" ToolTip="Close (Esc)" />
                            <Button x:Name="PileViewerModeButton" DockPanel.Dock="Right" Style="{StaticResource SmallButton}"
                                    VerticalAlignment="Center" Click="PileViewerMode_Click"
                                    ToolTip="Switch between the cards laid out in order and a compact list" />
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock x:Name="PileViewerTitle" FontFamily="{StaticResource DisplayFont}" FontSize="34"
                                           Foreground="{StaticResource GoldBrush}" />
                                <TextBlock x:Name="PileViewerSubtitle" Style="{StaticResource Muted}" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                        <Border x:Name="PileViewerPreview" DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Top" />
                        <ScrollViewer x:Name="PileViewerScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ContentControl x:Name="PileViewerContent" Focusable="False" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Right-click inspect: one big crisp card; any click or Esc closes it -->
            <Grid x:Name="InspectOverlay" Visibility="Collapsed" Background="#C8020310" Cursor="Hand"
                  MouseDown="InspectOverlay_MouseDown">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border x:Name="InspectHost" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Grid.Row="1" Text="Click, right-click or Esc to close" Style="{StaticResource Muted}"
                           HorizontalAlignment="Center" Margin="0,0,0,10" />
            </Grid>

            <!-- Online: the opponent dropped (or our own link is reconnecting). The game waits; you can leave. -->
            <Border x:Name="OnlineWaitPanel" Visibility="Collapsed" Background="#A0000000">
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Padding="36,24" CornerRadius="18"
                        Background="#EE0A0D24" BorderBrush="#CCFFC94A" BorderThickness="2">
                    <Border.Effect>
                        <DropShadowEffect Color="#FFC94A" BlurRadius="30" ShadowDepth="0" Opacity="0.6" />
                    </Border.Effect>
                    <StackPanel MaxWidth="520">
                        <TextBlock x:Name="OnlineWaitTitle" FontFamily="{StaticResource DisplayFont}" FontSize="44"
                                   Foreground="{StaticResource GoldBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock x:Name="OnlineWaitText" FontSize="16" Foreground="#FFC8D2F0" HorizontalAlignment="Center"
                                   TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,16" />
                        <Button x:Name="OnlineWaitLeave" Content="LEAVE GAME" Style="{StaticResource SmallButton}" HorizontalAlignment="Center"
                                Click="Menu_Click" />
                    </StackPanel>
                </Border>
            </Border>

            <!-- Game over overlay -->
            <Border x:Name="GameOverPanel" Visibility="Collapsed" Background="#B0000000">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="GameOverTitle" FontFamily="{StaticResource DisplayFont}" FontSize="110"
                               HorizontalAlignment="Center" Foreground="{StaticResource GoldBrush}">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#FFC94A" BlurRadius="40" ShadowDepth="0" />
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock x:Name="GameOverSubtitle" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,24" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="PlayAgainButton" Content="PLAY AGAIN" Style="{StaticResource GlowButton}" Click="PlayAgain_Click" Margin="8" />
                        <Button Content="MENU" Style="{StaticResource GlowButton}" Click="Menu_Click" Margin="8" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===================== SIDE PANEL ===================== -->
        <Border Grid.Column="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1,0,0,0">
            <Grid Margin="14,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Zoomed card -->
                <Border x:Name="ZoomHost" Grid.Row="0" Height="330" HorizontalAlignment="Center" Margin="0,0,0,8">
                    <TextBlock x:Name="ZoomHint" Text="Hover a card to inspect it&#x0a;Right-click a card to enlarge it&#x0a;Click a face-up pile to see all its cards" TextAlignment="Center" Style="{StaticResource Muted}"
                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Border>

                <!-- Round + score -->
                <StackPanel Grid.Row="1">
                    <TextBlock Text="{Binding RoundText}" Style="{StaticResource Heading}" HorizontalAlignment="Center" />
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding PlayerName}" Foreground="{StaticResource PlayerBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="MyTotalText" Text="0" FontFamily="{StaticResource DisplayFont}" FontSize="58" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding MyPips}" Foreground="{StaticResource GoldBrush}" FontSize="18" HorizontalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="vs" VerticalAlignment="Center" Style="{StaticResource Muted}" FontSize="16" />
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding AiName}" Foreground="{StaticResource OpponentBrush}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock x:Name="AiTotalText" Text="0" FontFamily="{StaticResource DisplayFont}" FontSize="58" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding AiPips}" Foreground="{StaticResource GoldBrush}" FontSize="18" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <!-- Tug-of-war: the knot slides towards whoever is winning the round (The Oculus flips it). -->
                    <Grid x:Name="TugTrack" Height="10" Margin="10,6,10,0"
                          ToolTip="Who is winning the round right now (with The Oculus, the lower total wins)">
                        <Border CornerRadius="5" Background="#FFEF4444" Opacity="0.8" />
                        <Border x:Name="TugBlue" CornerRadius="5" Background="#FF3B82F6" HorizontalAlignment="Left" Width="0" />
                        <Ellipse x:Name="TugKnot" Width="18" Height="18" Margin="0,-4,0,-4" HorizontalAlignment="Left"
                                 Fill="White" Stroke="#FFFFC94A" StrokeThickness="2">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="TugKnotShift" />
                            </Ellipse.RenderTransform>
                            <Ellipse.Effect>
                                <DropShadowEffect x:Name="TugGlow" Color="#FFC94A" BlurRadius="12" ShadowDepth="0" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                </StackPanel>

                <!-- Turn status + pass -->
                <StackPanel Grid.Row="2" Margin="0,8,0,0">
                    <!-- Turn clock: shown while someone is deciding (GameView.TurnClock.cs). -->
                    <StackPanel x:Name="TurnClockPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2"
                                Visibility="Collapsed" IsHitTestVisible="False">
                        <TextBlock x:Name="TurnClockLabel" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"
                                   Margin="0,0,8,0" Text="YOUR CLOCK" />
                        <TextBlock x:Name="TurnClockText" FontFamily="{StaticResource DisplayFont}" FontSize="30" Foreground="White"
                                   MinWidth="56" TextAlignment="Center" Text="2:00" />
                    </StackPanel>
                    <TextBlock Text="{Binding Status}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                    <TextBlock Text="{Binding Hint}" Style="{StaticResource Muted}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,2,0,6" />
                    <TextBlock Text="{Binding HandRevealNote}" Foreground="#C084FC" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,4">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button x:Name="PassButton" Content="{Binding PassText}" Style="{StaticResource GlowButton}" Click="Pass_Click"
                            IsEnabled="{Binding CanPass}" HorizontalAlignment="Stretch" ToolTip="Pass / no response (Space)" />
                </StackPanel>

                <!-- View controls -->
                <Grid Grid.Row="3" Margin="0,10,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Tilt" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Slider x:Name="TiltSlider" Grid.Column="1" Minimum="0" Maximum="58" Value="38" ValueChanged="Camera_Changed" />
                    <TextBlock Grid.Row="1" Text="Zoom" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Slider x:Name="ZoomSlider" Grid.Row="1" Grid.Column="1" Minimum="0.7" Maximum="1.4" Value="1" IsDirectionReversed="True" ValueChanged="Camera_Changed" ToolTip="1.0 (default) = the whole board fits" />
                    <TextBlock Grid.Row="2" Text="Speed" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Slider x:Name="SpeedSlider" Grid.Row="2" Grid.Column="1" Minimum="0.2" Maximum="2" Value="1" IsDirectionReversed="True" ValueChanged="Speed_Changed" ToolTip="Animation speed" />
                    <CheckBox x:Name="MagnifyCheck" Grid.Row="3" Grid.ColumnSpan="2" IsChecked="True"
                              Content="Magnify hand cards on hover" Checked="MagnifyCheck_Changed" Unchecked="MagnifyCheck_Changed"
                              ToolTip="Shows a large, readable copy of the hand card under the mouse. Right-click any card for a full-size view." />
                    <CheckBox x:Name="PauseReactsCheck" Grid.Row="4" Grid.ColumnSpan="2" IsChecked="True"
                              Content="Pause when I can React" Checked="PauseReacts_Changed" Unchecked="PauseReacts_Changed"
                              ToolTip="On: the game stops and asks whenever one of your Reacts can answer what just happened. Off: you never respond (auto-allow everything)." />
                    <CheckBox x:Name="SoundCheck" Grid.Row="5" IsChecked="True" Content="Sound" VerticalAlignment="Center"
                              Checked="Sound_Changed" Unchecked="Sound_Changed" ToolTip="Sound effects (generated in code, no files needed)." />
                    <Slider x:Name="VolumeSlider" Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="1" Value="0.6"
                            ValueChanged="Sound_Changed" ToolTip="Sound volume" />
                    <CheckBox x:Name="MusicCheck" Grid.Row="6" Grid.ColumnSpan="2" IsChecked="True" Content="Music"
                              Checked="Music_Changed" Unchecked="Music_Changed"
                              ToolTip="A generated music bed. A pulse layer fades in when the round is close." />
                    <CheckBox x:Name="ReduceFxCheck" Grid.Row="7" Grid.ColumnSpan="2" Content="Reduce effects"
                              Checked="FxSettings_Changed" Unchecked="FxSettings_Changed"
                              ToolTip="Tones down flashes, screen shake, lightning and camera pushes (easier on the eyes, faster to follow)." />
                    <TextBlock Grid.Row="8" Text="Effects" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="FxQualityBox" Grid.Row="8" Grid.Column="1" Margin="0,2,0,0" SelectionChanged="FxSettings_Changed"
                              ToolTip="Low skips the heavier ambient layers, blurs, idle motion and card trails, and uses fewer particles (for older PCs).">
                        <ComboBoxItem Content="Low quality" Tag="Low" />
                        <ComboBoxItem Content="High quality" Tag="High" />
                    </ComboBox>
                </Grid>

                <!-- Log -->
                <Border Grid.Row="4" Background="#30000000" CornerRadius="10" Padding="4">
                <ListBox ItemsSource="{Binding Log}" FontSize="12">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="#FFC8D2F0" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </Border>

                <!-- Online: chat with your opponent -->
                <Border x:Name="ChatPanel" Grid.Row="5" Background="#30000000" CornerRadius="10" Padding="6" Margin="0,8,0,0"
                        Visibility="Collapsed">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <Button DockPanel.Dock="Right" Content="SEND" Style="{StaticResource SmallButton}" Margin="6,0,0,0"
                                    Click="ChatSend_Click" />
                            <TextBox x:Name="ChatInput" MaxLength="300" KeyDown="ChatInput_KeyDown"
                                     ToolTip="Type a message and press Enter (Esc returns to the game)" />
                        </DockPanel>
                        <ListBox x:Name="ChatList" ItemsSource="{Binding Chat}" FontSize="13" Height="110">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#FFFCA5A5" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Mine}" Value="True">
                                                        <Setter Property="Foreground" Value="#FF93C5FD" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Notice}" Value="True">
                                                        <Setter Property="Foreground" Value="#FF94A3B8" />
                                                        <Setter Property="FontStyle" Value="Italic" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <DockPanel Grid.Row="6" Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Content="MENU" Style="{StaticResource SmallButton}" Click="Menu_Click" />
                    <TextBlock Text="{Binding NetStatus}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#FF86EFAC" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NetOk}" Value="False">
                                        <Setter Property="Foreground" Value="#FFFFC94A" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
