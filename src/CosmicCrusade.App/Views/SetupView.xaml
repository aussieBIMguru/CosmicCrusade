<UserControl x:Class="CosmicCrusade.App.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:CosmicCrusade.App.Controls">
    <Grid>
        <controls:Starfield />

        <Grid Margin="40,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <!-- Title + options -->
            <StackPanel Grid.Column="0">
                <DockPanel Margin="0,-10,0,-30">
                    <Image DockPanel.Dock="Right" Source="pack://application:,,,/Assets/CosmicCrusade-1024.png" Width="104" Height="104"
                           VerticalAlignment="Center" Margin="0,8,0,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="COSMIC" FontFamily="{StaticResource DisplayFont}" FontSize="96" Foreground="White">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#7C3AED" BlurRadius="30" ShadowDepth="0" />
                        </TextBlock.Effect>
                    </TextBlock>
                </DockPanel>
                <TextBlock Text="CRUSADE" FontFamily="{StaticResource DisplayFont}" FontSize="96" Foreground="{StaticResource GoldBrush}">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#F59E0B" BlurRadius="30" ShadowDepth="0" />
                    </TextBlock.Effect>
                </TextBlock>

                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1"
                        CornerRadius="14" Padding="18" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="GAME SETUP" Style="{StaticResource Heading}" Margin="0,0,0,8" />

                        <TextBlock Text="Rounds to win" Style="{StaticResource Muted}" />
                        <DockPanel Margin="0,2,0,10">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding RoundsToWin}" Width="28" TextAlignment="Right" FontSize="16" />
                            <Slider Minimum="1" Maximum="9" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding RoundsToWin}" />
                        </DockPanel>

                        <TextBlock Text="AI difficulty" Style="{StaticResource Muted}"
                                   ToolTip="Easy: rule-of-thumb play. Normal / Hard: the AI simulates its options before each turn (Hard thinks longer)." />
                        <ComboBox ItemsSource="{Binding AiDifficulties}" SelectedItem="{Binding AiDifficulty}" Margin="0,2,0,10" />

                        <TextBlock Text="Turn clock (minutes per turn)" Style="{StaticResource Muted}"
                                   ToolTip="How long you have to decide each turn (0 = no clock). With 15 seconds left a fuse burns along the middle of the board; when it runs out you pass. Online, the host's setting is used." />
                        <DockPanel Margin="0,2,0,10">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding TurnClockDisplay}" Width="56" TextAlignment="Right" FontSize="16" />
                            <Slider Minimum="0" Maximum="10" IsSnapToTickEnabled="True" TickFrequency="0.5" Value="{Binding TurnMinutes}" />
                        </DockPanel>

                        <TextBlock Text="Deck mode" Style="{StaticResource Muted}" />
                        <ComboBox ItemsSource="{Binding DeckModes}" SelectedItem="{Binding DeckMode}" Margin="0,2,0,10" />

                        <TextBlock Text="When a deck runs out" Style="{StaticResource Muted}" />
                        <ComboBox ItemsSource="{Binding EmptyDeckRules}" SelectedItem="{Binding EmptyDeck}" Margin="0,2,0,10" />

                        <CheckBox Content="Leaders (untick for No Leaders mode)" IsChecked="{Binding Leaders}" />
                        <CheckBox Content="Warzones expansion orders" IsChecked="{Binding Warzones}"
                                  ToolTip="Adds the Warzone deck (one Warzone revealed each round) and the Warzones Orders." />
                        <CheckBox Content="Archons (once-per-game power cards)" IsChecked="{Binding Archons}"
                                  ToolTip="Optional module. Once per game, at a round's Start-up, each player may take an Archon draw: see 3 Archons, keep 1 (revealed) to play that round, and draw one card fewer." />
                        <CheckBox Content="Spacecraft (ships your Units can crew)" IsChecked="{Binding Spacecraft}"
                                  ToolTip="Optional module. Adds spacecraft to the Unit deck and their Orders to the Order deck (and their Warzones when Warzones is on). Deploy a Unit onto your own spacecraft, or a spacecraft onto your Unit: the crew is elevated, out of reach of the ground, and both count towards your Rank." />

                        <TextBlock Text="Seed (blank = random)" Style="{StaticResource Muted}" Margin="0,8,0,0" />
                        <TextBox Text="{Binding Seed, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" />

                        <TextBlock Text="{Binding Totals}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" Margin="0,6,0,14" />

                        <Button Content="PLAY VS AI" Style="{StaticResource GlowButton}" FontSize="32" Click="Start_Click" IsEnabled="{Binding IsIdle}" />
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="2,12,0,0">
                    New to Cosmic Crusade?
                    <Hyperlink Click="Doc_Click" Tag="HOW-TO-PLAY.md" Foreground="{StaticResource AccentBrush}">How to play</Hyperlink> ·
                    <Hyperlink Click="Doc_Click" Tag="RULEBOOK.md" Foreground="{StaticResource AccentBrush}">Rulebook</Hyperlink> ·
                    <Hyperlink Click="Doc_Click" Tag="GLOSSARY.md" Foreground="{StaticResource AccentBrush}">Glossary</Hyperlink> ·
                    <Hyperlink Click="Doc_Click" Tag="PLAYING-ONLINE.md" Foreground="{StaticResource AccentBrush}">Playing online</Hyperlink>
                </TextBlock>
            </StackPanel>

            <!-- Card pool -->
            <Border Grid.Column="1" Margin="24,0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1" CornerRadius="14" Padding="14">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="RESET COUNTS" Style="{StaticResource SmallButton}" Command="{Binding ResetCountsCommand}" />
                        <TextBlock Text="CARD POOL" Style="{StaticResource Heading}" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Text="Filter" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" Style="{StaticResource Muted}" FontSize="12"
                               Text="&#x25A1; not implemented yet   &#x25E7; partly implemented   (hover the box for details; sort by the first column)" />
                    <DataGrid ItemsSource="{Binding CardsView}" SelectedItem="{Binding SelectedCard}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="26" IsReadOnly="True" SortMemberPath="StatusOrder" CanUserSort="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <!-- Empty box: not implemented yet. Half-filled box: partly implemented. Nothing: fully implemented. -->
                                        <Grid Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              ToolTip="{Binding StatusTip}" Background="Transparent">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFullyImplemented}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Rectangle Fill="#F0F0FA" Height="6" VerticalAlignment="Bottom">
                                                <Rectangle.Style>
                                                    <Style TargetType="Rectangle">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPartlyImplemented}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Rectangle.Style>
                                            </Rectangle>
                                            <Border BorderBrush="#F0F0FA" BorderThickness="1.5" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Id" Binding="{Binding Id}" IsReadOnly="True" Width="56" />
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" IsReadOnly="True" Width="*" />
                            <DataGridTextColumn Header="Race" Binding="{Binding Race}" IsReadOnly="True" Width="120" />
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" IsReadOnly="True" Width="130" />
                            <DataGridTextColumn Header="Set" Binding="{Binding SetName}" IsReadOnly="True" Width="74" />
                            <DataGridTextColumn Header="Copies" Binding="{Binding Copies, UpdateSourceTrigger=PropertyChanged}" Width="64">
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Setter Property="Padding" Value="4,0" />
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Player + online play (bottom), card preview (top) -->
            <DockPanel Grid.Column="2">
                <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                        BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="PLAYER" Style="{StaticResource Heading}" Margin="0,0,0,4" />
                        <TextBlock Text="Your name" Style="{StaticResource Muted}" />
                        <TextBox Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" Margin="0,2,0,10"
                                 ToolTip="Shown on the score panel, and to your opponent online. Remembered for next time." />

                        <TextBlock Text="PLAY ONLINE" Style="{StaticResource Heading}" Margin="0,4,0,4" />
                        <TextBlock Text="Server" Style="{StaticResource Muted}" />
                        <TextBox Text="{Binding ServerAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,8" IsEnabled="{Binding IsIdle}"
                                 ToolTip="Your relay's address, e.g. cosmic-crusade-relay.yourname.workers.dev&#x0a;On a home network: ws://localhost:5080 on the PC running the LAN Server, ws://&lt;that PC's IP&gt;:5080 on the others.&#x0a;See the Playing online and LAN guides (links on the left)." />

                        <Button Content="HOST GAME" Style="{StaticResource SmallButton}" Click="Host_Click" IsEnabled="{Binding IsIdle}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,6"
                                ToolTip="Uses the setup on the left (rounds, modules, card pool). You get a code to give your opponent." />
                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="JOIN" Style="{StaticResource SmallButton}" Click="Join_Click"
                                    IsEnabled="{Binding IsIdle}" Margin="6,0,0,0" />
                            <TextBox Text="{Binding JoinCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" IsEnabled="{Binding IsIdle}"
                                     CharacterCasing="Upper" FontSize="16" KeyDown="JoinCode_KeyDown"
                                     ToolTip="The code your opponent got when they hosted" />
                        </DockPanel>

                        <TextBlock Text="{Binding HostCode}" FontFamily="{StaticResource DisplayFont}" FontSize="48" HorizontalAlignment="Center"
                                   Foreground="{StaticResource GoldBrush}" Cursor="Hand" MouseLeftButtonDown="HostCode_Click"
                                   ToolTip="Click to copy">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHosting}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding OnlineStatus}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource AccentBrush}" />
                        <Button Content="CANCEL" Click="CancelOnline_Click" HorizontalAlignment="Right"
                                Margin="0,6,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SmallButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding OnlineBusy}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>

                <StackPanel>
                    <Border x:Name="PreviewHost" Height="300" />
                    <TextBlock Text="{Binding SelectedCard.Definition.Text}" TextWrapping="Wrap" Margin="0,10,0,0" Style="{StaticResource Muted}" FontSize="13" />
                    <TextBlock Text="{Binding SelectedCard.StatusTip}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="12" Foreground="#FFC94A" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
