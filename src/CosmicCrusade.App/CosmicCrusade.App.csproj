<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>CosmicCrusade.App</RootNamespace>
    <AssemblyName>CosmicCrusade</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- The exe / taskbar icon. The window title bar uses the same file (MainWindow Icon). -->
    <ApplicationIcon>Assets\CosmicCrusade.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\CosmicCrusade.ico" />
    <Resource Include="Assets\CosmicCrusade-1024.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CosmicCrusade.Core\CosmicCrusade.Core.csproj" />
  </ItemGroup>

  <!-- Card data, art, strips and layout are copied next to the exe under data\ -->
  <ItemGroup>
    <None Include="..\..\data\**\*" LinkBase="data" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The licence (MIT for the software; the game content is all rights reserved) and third-party notices ship with the app -->
  <ItemGroup>
    <None Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Player guides (How to play, Rulebook, Glossary, online guides) ship next to the exe under docs\ -->
  <ItemGroup>
    <None Include="..\..\docs\players\*.md" LinkBase="docs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
