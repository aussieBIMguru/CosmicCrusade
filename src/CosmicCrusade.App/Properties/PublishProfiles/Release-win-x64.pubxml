<?xml version="1.0" encoding="utf-8"?>
<!--
  Visual Studio publish profile: right-click CosmicCrusade.App > Publish > "Release-win-x64" > Publish.
  Self-contained win-x64 folder (players need no .NET runtime), not single-file, no trimming: the same settings as
  build\publish.ps1, which also runs the tests and builds the installer. The output is artifacts\app\ at the repo root,
  which is exactly what installer\CosmicCrusade.iss packs, so you can compile the .iss in Inno Setup straight after.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <PublishDir>..\..\artifacts\app\</PublishDir>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <DeleteExistingFiles>true</DeleteExistingFiles>
  </PropertyGroup>
</Project>
