<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CosmicCrusade.Core\CosmicCrusade.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\data\cards.json" Link="data\cards.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\data\game-modes.json" Link="data\game-modes.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\data\pools\*.json" Link="data\pools\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
